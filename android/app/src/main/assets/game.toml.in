# Android runtime config, written by the start menu after the user selects
# their own disc image (it fills the disc placeholder).
[game]
name = "Alundra"
id = "SLES-01258"
players = 1
exe = "disc/SLES_012.58"
discs = [
  @@DISC1@@,
]
load_address = "0x80020000"
entry_pc = "0x800360F4"
text_size = "0x0012B000"
stack_base = "0x801FFFF0"

[recompiler]
seeds = "seeds/ghidra_funcs.txt"
out_dir = "generated"
strict = true

[video]
# Software renderer: the verified path on Android. The menu's Renderer choice
# writes "opengl" here (OpenGL ES, experimental).
renderer = "software"

[runtime]
overlay_cache = true

[controller]
default_mode = "digital"

[bios]
path = "bios/openbios.bin"
